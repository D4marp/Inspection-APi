{
  "name": "dpl-inspection-training-api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Express API untuk uji coba aplikasi Flutter DPL Inspection.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec",
    "test:watch": "node --test --watch",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
